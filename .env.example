# Anthropic / Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-5-5

# Meta Instagram Login and webhook
IG_APP_ID=your_instagram_app_id
IG_APP_SECRET=your_instagram_app_secret
IG_REDIRECT_URI=https://your-public-domain/instagram/callback
IG_WEBHOOK_VERIFY_TOKEN=make_a_long_random_string
IG_ACCESS_TOKEN=
IG_USER_ID=

# Telegram inbox bot (required when running main.py / Telegram service)
TELEGRAM_BOT_TOKEN=

# Optional lead notification bot and recipient chat ID
TELEGRAM_BOT_TOKEN2=
TELEGRAM_USER_ID=

# Password-protected dashboard
DASHBOARD_PASSWORD=change_to_a_long_random_password
DASHBOARD_SECRET_KEY=change_to_a_long_random_secret
